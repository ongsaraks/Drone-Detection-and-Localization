# syntax=docker/dockerfile:1.7
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.detector.txt /app/requirements.detector.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /app/requirements.detector.txt

COPY Integrate.py /app/Integrate.py

CMD ["python", "-u", "Integrate.py"]
